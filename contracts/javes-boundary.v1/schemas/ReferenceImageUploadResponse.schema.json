{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Stable storage/archive identity, never a short-lived playback URL.",
      "properties": {
        "archive_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Archive Id"
        },
        "object_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Key"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "height_px": {
      "exclusiveMinimum": 0,
      "title": "Height Px",
      "type": "integer"
    },
    "mime_type": {
      "const": "image/jpeg",
      "default": "image/jpeg",
      "title": "Mime Type",
      "type": "string"
    },
    "reference_image_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "size_bytes": {
      "exclusiveMinimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "upload_id": {
      "title": "Upload Id",
      "type": "string"
    },
    "width_px": {
      "exclusiveMinimum": 0,
      "title": "Width Px",
      "type": "integer"
    }
  },
  "required": [
    "upload_id",
    "case_id",
    "reference_image_ref",
    "size_bytes",
    "width_px",
    "height_px",
    "expires_at"
  ],
  "title": "ReferenceImageUploadResponse",
  "type": "object"
}
