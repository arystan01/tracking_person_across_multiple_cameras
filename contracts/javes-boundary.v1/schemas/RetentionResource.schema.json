{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Stable storage/archive identity, never a short-lived playback URL.",
      "properties": {
        "archive_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Archive Id"
        },
        "object_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Key"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "title": "ArtifactRef",
      "type": "object"
    },
    "RetentionClass": {
      "enum": [
        "EPHEMERAL",
        "REVIEW_HOLD",
        "CASE_RESULT",
        "CONFIRMED_EVIDENCE",
        "AUDIT"
      ],
      "title": "RetentionClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "contract_version": {
      "const": "retention-resource.v1",
      "default": "retention-resource.v1",
      "title": "Contract Version",
      "type": "string"
    },
    "deleted": {
      "default": false,
      "title": "Deleted",
      "type": "boolean"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "legal_hold": {
      "default": false,
      "title": "Legal Hold",
      "type": "boolean"
    },
    "resource_id": {
      "title": "Resource Id",
      "type": "string"
    },
    "retention_class": {
      "$ref": "#/$defs/RetentionClass"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    }
  },
  "required": [
    "resource_id",
    "case_id",
    "kind",
    "retention_class"
  ],
  "title": "RetentionResource",
  "type": "object"
}
