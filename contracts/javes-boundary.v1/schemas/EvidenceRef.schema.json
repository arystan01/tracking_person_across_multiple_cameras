{
  "additionalProperties": false,
  "properties": {
    "media_type": {
      "minLength": 1,
      "title": "Media Type",
      "type": "string"
    },
    "name": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Name",
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "title": "Path",
      "type": "string"
    },
    "schema_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Schema Id"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    }
  },
  "required": [
    "name",
    "path",
    "size_bytes",
    "sha256",
    "media_type"
  ],
  "title": "EvidenceRef",
  "type": "object"
}
