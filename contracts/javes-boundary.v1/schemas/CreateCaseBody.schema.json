{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Stable storage/archive identity, never a short-lived playback URL.",
      "properties": {
        "archive_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Archive Id"
        },
        "object_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Key"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "title": "ArtifactRef",
      "type": "object"
    },
    "CaseWindow": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "CaseWindow",
      "type": "object"
    },
    "LastKnown": {
      "additionalProperties": false,
      "properties": {
        "bbox_xywh": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox Xywh"
        },
        "camera_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera Id"
        },
        "footpoint_px": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Footpoint Px"
        },
        "map_position": {
          "anyOf": [
            {
              "$ref": "#/$defs/MapPosition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "time": {
          "format": "date-time",
          "title": "Time",
          "type": "string"
        },
        "zone_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zone Id"
        }
      },
      "required": [
        "time"
      ],
      "title": "LastKnown",
      "type": "object"
    },
    "MapPosition": {
      "additionalProperties": false,
      "properties": {
        "error_m": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Error M",
          "type": "number"
        },
        "floor_id": {
          "title": "Floor Id",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "floor_id"
      ],
      "title": "MapPosition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "last_known": {
      "$ref": "#/$defs/LastKnown"
    },
    "operator_id": {
      "title": "Operator Id",
      "type": "string"
    },
    "profile": {
      "default": "ADULT",
      "enum": [
        "ADULT",
        "CHILD",
        "ELDERLY"
      ],
      "title": "Profile",
      "type": "string"
    },
    "reference_image_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reference_upload_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Upload Id"
    },
    "site_id": {
      "title": "Site Id",
      "type": "string"
    },
    "site_version": {
      "title": "Site Version",
      "type": "string"
    },
    "target_id": {
      "title": "Target Id",
      "type": "string"
    },
    "window": {
      "$ref": "#/$defs/CaseWindow"
    }
  },
  "required": [
    "case_id",
    "operator_id",
    "target_id",
    "last_known",
    "window",
    "site_id",
    "site_version"
  ],
  "title": "CreateCaseBody",
  "type": "object"
}
