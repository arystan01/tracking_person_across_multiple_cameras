{
  "$defs": {
    "VerifiedEvidenceFile": {
      "additionalProperties": false,
      "properties": {
        "computed_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Computed Sha256"
        },
        "computed_size_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Computed Size Bytes"
        },
        "declared_sha256": {
          "title": "Declared Sha256",
          "type": "string"
        },
        "declared_size_bytes": {
          "title": "Declared Size Bytes",
          "type": "integer"
        },
        "failure_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Code"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "schema_valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Valid"
        }
      },
      "required": [
        "name",
        "path",
        "media_type",
        "declared_sha256",
        "declared_size_bytes",
        "passed"
      ],
      "title": "VerifiedEvidenceFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "files": {
      "items": {
        "$ref": "#/$defs/VerifiedEvidenceFile"
      },
      "title": "Files",
      "type": "array"
    },
    "git_commit_failure_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Commit Failure Code"
    },
    "git_commit_verified": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Commit Verified"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "javes-evidence-verification.v1",
      "default": "javes-evidence-verification.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "manifest_sha256",
    "files"
  ],
  "title": "EvidenceBundleVerification",
  "type": "object"
}
