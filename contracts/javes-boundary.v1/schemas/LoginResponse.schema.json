{
  "$defs": {
    "ActorView": {
      "additionalProperties": false,
      "properties": {
        "must_change_password": {
          "title": "Must Change Password",
          "type": "boolean"
        },
        "permissions": {
          "items": {
            "type": "string"
          },
          "title": "Permissions",
          "type": "array"
        },
        "role": {
          "enum": [
            "ROOT",
            "ADMIN",
            "OPERATOR",
            "VIEWER",
            "SERVICE"
          ],
          "title": "Role",
          "type": "string"
        },
        "user_id": {
          "title": "User Id",
          "type": "string"
        },
        "username": {
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "username",
        "role",
        "permissions",
        "must_change_password"
      ],
      "title": "ActorView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "access_token": {
      "title": "Access Token",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "token_type": {
      "const": "bearer",
      "default": "bearer",
      "title": "Token Type",
      "type": "string"
    },
    "user": {
      "$ref": "#/$defs/ActorView"
    }
  },
  "required": [
    "access_token",
    "expires_at",
    "user"
  ],
  "title": "LoginResponse",
  "type": "object"
}
