{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "association_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Association Id"
        },
        "calibration_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Version"
        },
        "cosine": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cosine"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "tracklet_id": {
          "title": "Tracklet Id",
          "type": "string"
        }
      },
      "required": [
        "tracklet_id",
        "score"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "ProbeStatus": {
      "enum": [
        "DONE",
        "FAILED",
        "TIMEOUT",
        "UNAVAILABLE"
      ],
      "title": "ProbeStatus",
      "type": "string"
    },
    "Tracklet": {
      "additionalProperties": false,
      "properties": {
        "bbox_first": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox First",
          "type": "array"
        },
        "bbox_last": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox Last",
          "type": "array"
        },
        "camera": {
          "title": "Camera",
          "type": "string"
        },
        "case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "clip_ref": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Ref"
        },
        "clipped_in": {
          "default": false,
          "title": "Clipped In",
          "type": "boolean"
        },
        "clipped_out": {
          "default": false,
          "title": "Clipped Out",
          "type": "boolean"
        },
        "crop_paths": {
          "items": {
            "type": "string"
          },
          "title": "Crop Paths",
          "type": "array"
        },
        "embedding_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Path"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "open": {
          "default": false,
          "title": "Open",
          "type": "boolean"
        },
        "probe_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probe Id"
        },
        "t_in": {
          "format": "date-time",
          "title": "T In",
          "type": "string"
        },
        "t_out": {
          "format": "date-time",
          "title": "T Out",
          "type": "string"
        },
        "trajectory": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/TrajectoryPoint"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trajectory"
        }
      },
      "required": [
        "id",
        "camera",
        "t_in",
        "t_out",
        "bbox_first",
        "bbox_last"
      ],
      "title": "Tracklet",
      "type": "object"
    },
    "TrajectoryPoint": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "x_px": {
          "title": "X Px",
          "type": "number"
        },
        "y_px": {
          "title": "Y Px",
          "type": "number"
        }
      },
      "required": [
        "timestamp",
        "x_px",
        "y_px"
      ],
      "title": "TrajectoryPoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "coverage_ratio": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Coverage Ratio",
      "type": "number"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "n_tracklets_total": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "N Tracklets Total"
    },
    "probe_id": {
      "title": "Probe Id",
      "type": "string"
    },
    "processed_duration_s": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Processed Duration S"
    },
    "status": {
      "$ref": "#/$defs/ProbeStatus"
    },
    "stream_closed": {
      "default": false,
      "title": "Stream Closed",
      "type": "boolean"
    },
    "tracklets": {
      "items": {
        "$ref": "#/$defs/Tracklet"
      },
      "title": "Tracklets",
      "type": "array"
    }
  },
  "required": [
    "probe_id",
    "status"
  ],
  "title": "ProbeResult",
  "type": "object"
}
